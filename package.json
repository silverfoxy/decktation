{
  "name": "decktation",
  "version": "0.3.20",
  "description": "Push-to-talk dictation for Steam Deck with context-aware transcription",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:update": "node --test tests/frontend-plugin-update.test.cjs",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "dev:integration": "node tests/integration/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/silverfoxy/decktation.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "dictation",
    "voice",
    "speech-to-text",
    "input",
    "gaming",
    "accessibility"
  ],
  "author": "silverfoxy",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@rollup/plugin-commonjs": "^21.1.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-test-renderer": "19.2.7",
    "rollup": "^2.79.2",
    "rollup-plugin-import-assets": "^1.1.1",
    "shx": "^0.3.4",
    "tslib": "^2.4.0",
    "typescript": "^4.7.4",
    "vite": "6.4.4"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "decky-frontend-lib": "^3.25.0",
    "react-icons": "^4.4.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
