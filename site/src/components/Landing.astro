---
import { dictionaries, locales, localeNames, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (key: keyof typeof dictionaries.en) => dictionaries[locale][key];
---

<a class="skip" href="#main" data-i18n="skip">{t("skip")}</a><header>
  <div class="wrap">
    <nav>
      <a class="brand" href="/"><span class="brand-art"><img class="brand-logo" src="/assets/decktation-logo.png" width="979" height="418" alt="Decktation"/><span class="brand-wave-cover" aria-hidden="true"></span><img class="brand-wave" src="/assets/decktation-logo.png" width="979" height="418" alt="" aria-hidden="true"/></span></a>
      <div class="navlinks" id="navigation">
        <a href="#how" data-i18n="nav.how">{t("nav.how")}</a>
        <a href="#wow" data-i18n="nav.wow">{t("nav.wow")}</a>
        <a href="#features" data-i18n="nav.features">{t("nav.features")}</a>
        <a href="#install" data-i18n="nav.install">{t("nav.install")}</a>
        <a href="#faq" data-i18n="nav.faq">{t("nav.faq")}</a>
        <label class="language-control"><i class="fa-solid fa-language" aria-hidden="true"></i><span class="sr-only" data-i18n="language">{t("language")}</span><select id="language-select" aria-label={t("a11y.language")}>{locales.map((lang) => <option value={lang} data-url={lang === "en" ? "/" : `/${lang}/`} selected={lang === locale}>{localeNames[lang]}</option>)}</select></label>
      </div>
      <div class="actions"><a class="github-link" href="https://github.com/silverfoxy/decktation" aria-label="GitHub"><i class="fa-brands fa-github icon" aria-hidden="true"></i></a>

        <a class="btn primary secondary-header" href="#install" data-i18n="cta.install">{t("cta.install")}</a>
        <button class="btn mobile-menu" aria-label={t("a11y.menu")} aria-expanded="false" aria-controls="navigation"><i class="fa-solid fa-bars icon" aria-hidden="true"></i></button>
      </div>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow" data-i18n="hero.eyebrow">{t("hero.eyebrow")}</div>
        <h1 data-i18n="hero.title">{t("hero.title").split("<br>").map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
        <p class="lead" data-i18n="hero.body">{t("hero.body")}</p>
        <div class="cta-row">
          <a class="btn primary" href="#install" data-i18n="cta.install">{t("cta.install")}</a>
          <a class="btn" href="#how" data-i18n="cta.how">{t("cta.how")}</a>
        </div>
        <div class="meta" data-i18n="hero.meta">{t("hero.meta")}</div>
      </div>
      <figure class="hero-shot live-demo animated-demo" data-phase="done">
        <div class="demo-device">
          <div class="demo-shoulder demo-shoulder-left" aria-hidden="true"></div>
          <div class="demo-shoulder demo-shoulder-right" aria-hidden="true"></div>
          <img class="demo-frame" src="/assets/deck-mockup.svg" width="1000" height="450" alt=""/>
          <div class="demo-screen" role="img" aria-label={t("a11y.hero")}>
            <img class="demo-game" src="/assets/game-placeholder.svg" width="960" height="600" alt="" fetchpriority="high"/>
            <div class="demo-chat" aria-hidden="true"><div class="demo-chat-message"><span data-i18n="demo.channel">{t("demo.channel")}</span> <span data-i18n="demo.message">{t("demo.message")}</span></div><div class="demo-input"><span class="demo-prefix">/p </span><span class="demo-typed" data-i18n="demo.message">{t("demo.message")}</span><span class="demo-cursor"></span></div></div>
            <div class="demo-overlay" aria-hidden="true"><span class="demo-dot"></span><div class="demo-bars"><span style="--bar:0"></span><span style="--bar:1"></span><span style="--bar:2"></span><span style="--bar:3"></span><span style="--bar:4"></span><span style="--bar:5"></span><span style="--bar:6"></span><span style="--bar:7"></span><span style="--bar:8"></span></div><span class="demo-transcribing" data-i18n="demo.transcribing">{t("demo.transcribing")}</span></div>
          </div>
        </div>
        <div class="demo-controls"><div class="demo-status" aria-hidden="true"><span class="demo-state-listening" data-i18n="demo.listening">{t("demo.listening")}</span><span class="demo-state-transcribing" data-i18n="demo.release">{t("demo.release")}</span><span class="demo-state-typing" data-i18n="demo.typing">{t("demo.typing")}</span><span class="demo-state-done" data-i18n="demo.done">{t("demo.done")}</span></div><button class="demo-toggle" type="button" aria-pressed="false"><i class="fa-solid fa-pause" aria-hidden="true"></i><span class="sr-only demo-pause-label" data-i18n="demo.pause">{t("demo.pause")}</span><span class="sr-only demo-play-label" data-i18n="demo.play">{t("demo.play")}</span></button></div>
      </figure>
    </div>
  </section>

  <section id="how" class="alt">
    <div class="wrap">
      <div class="section-label" data-i18n="how.label">{t("how.label")}</div>
      <h2 data-i18n="how.title">{t("how.title")}</h2>
      <div class="steps">
        <div class="step"><div class="num" data-i18n="how.one.number">{t("how.one.number")}</div><div><h3 data-i18n="how.one.title">{t("how.one.title")}</h3><p data-i18n="how.one.body">{t("how.one.body")}</p></div></div>
        <div class="step"><div class="num" data-i18n="how.two.number">{t("how.two.number")}</div><div><h3 data-i18n="how.two.title">{t("how.two.title")}</h3><p data-i18n="how.two.body">{t("how.two.body")}</p></div></div>
        <div class="step"><div class="num" data-i18n="how.three.number">{t("how.three.number")}</div><div><h3 data-i18n="how.three.title">{t("how.three.title")}</h3><p data-i18n="how.three.body">{t("how.three.body")}</p></div></div>
      </div>
    </div>
  </section>

  <section id="wow">
    <div class="wrap">
      <div class="section-label" data-i18n="wow.label">{t("wow.label")}</div>
      <h2 data-i18n="wow.title">{t("wow.title")}</h2>
      <p class="lead" data-i18n="wow.body">{t("wow.body")}</p>
      <div class="wow-grid">
        <figure class="wow-shot"><div class="wow-gameplay animated-demo" data-phase="done"><img src="/assets/wow-chat-empty.webp" width="1280" height="720" loading="lazy" alt={t("a11y.wow")}/><img class="wow-chat-filled" src={`/assets/wow-chat-filled-${locale}.webp`} width="1280" height="720" loading="lazy" alt="" aria-hidden="true"/>
            <div class="demo-overlay wow-recording" aria-hidden="true"><span class="demo-dot"></span><div class="demo-bars"><span style="--bar:0"></span><span style="--bar:1"></span><span style="--bar:2"></span><span style="--bar:3"></span><span style="--bar:4"></span><span style="--bar:5"></span><span style="--bar:6"></span><span style="--bar:7"></span><span style="--bar:8"></span></div><span class="demo-transcribing" data-i18n="demo.transcribing">{t("demo.transcribing")}</span></div></div><figcaption data-i18n="asset.wow">{t("asset.wow")}</figcaption></figure>
        <div class="routing"><div class="route route-label"><span data-i18n="routing.say">{t("routing.say")}</span><span></span><strong data-i18n="routing.types">{t("routing.types")}</strong></div>
          <div class="route"><span data-i18n="routing.party.spoken">{t("routing.party.spoken")}</span><span>→</span><strong data-i18n="routing.party.typed">{t("routing.party.typed")}</strong></div>
          <div class="route"><span data-i18n="routing.guild.spoken">{t("routing.guild.spoken")}</span><span>→</span><strong data-i18n="routing.guild.typed">{t("routing.guild.typed")}</strong></div>
          <div class="route"><span data-i18n="routing.reply.spoken">{t("routing.reply.spoken")}</span><span>→</span><strong data-i18n="routing.reply.typed">{t("routing.reply.typed")}</strong></div>
          <div class="route"><span data-i18n="routing.say.spoken">{t("routing.say.spoken")}</span><span>→</span><strong data-i18n="routing.say.typed">{t("routing.say.typed")}</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="alt">
    <div class="wrap">
      <h2 data-i18n="features.title">{t("features.title")}</h2>
      <p class="lead" data-i18n="features.body">{t("features.body")}</p>
      <div class="features">
        <article class="feature"><div class="feature-heading"><div class="ico"><i class="fa-solid fa-bolt icon" aria-hidden="true"></i></div><h3 data-i18n="features.fast.title">{t("features.fast.title")}</h3></div><p data-i18n="features.fast.body">{t("features.fast.body")}</p></article>
        <article class="feature"><div class="feature-heading"><div class="ico"><i class="fa-solid fa-gamepad icon" aria-hidden="true"></i></div><h3 data-i18n="features.controller.title">{t("features.controller.title")}</h3></div><p data-i18n="features.controller.body">{t("features.controller.body")}</p></article>
        <article class="feature"><div class="feature-heading"><div class="ico"><i class="fa-solid fa-shield-halved icon" aria-hidden="true"></i></div><h3 data-i18n="features.private.title">{t("features.private.title")}</h3></div><p data-i18n="features.private.body">{t("features.private.body")}</p></article>
        <article class="feature"><div class="feature-heading"><div class="ico"><i class="fa-solid fa-sliders icon" aria-hidden="true"></i></div><h3 data-i18n="features.presets.title">{t("features.presets.title")}</h3></div><p data-i18n="features.presets.body">{t("features.presets.body")}</p></article>
        <article class="feature"><div class="feature-heading"><div class="ico"><i class="fa-solid fa-language icon" aria-hidden="true"></i></div><h3 data-i18n="features.languages.title">{t("features.languages.title")}</h3></div><p data-i18n="features.languages.body">{t("features.languages.body")}</p><details><summary data-i18n="features.languages.list">{t("features.languages.list")}</summary><p data-i18n="features.languages.names">{t("features.languages.names")}</p><p data-i18n="features.languages.note">{t("features.languages.note")}</p></details></article>
      </div>
    </div>
  </section>

  <section id="install">
    <div class="wrap"><div class="install-band">
<div class="section-label" data-i18n="install.label">{t("install.label")}</div><h2 id="install-question" tabindex="-1" data-i18n="install.title">{t("install.title")}</h2>
      <div id="install-choices" class="install-choices"><button type="button" class="btn primary" data-install-path="existing" aria-controls="install-existing" data-i18n="install.yes">{t("install.yes")}</button><button type="button" class="btn" data-install-path="first" aria-controls="install-first" data-i18n="install.no">{t("install.no")}</button></div>
      <button type="button" id="install-change" class="text-link" hidden><span  data-i18n="install.change">{t("install.change")}</span></button>
      <div id="install-existing" class="install-path" hidden><h3 tabindex="-1" data-i18n="install.existingTitle">{t("install.existingTitle")}</h3><ol class="install-wizard">
        <li><h4  data-i18n="install.two">{t("install.two")}</h4><p  data-i18n="install.developer">{t("install.developer")}</p><details><summary  data-i18n="install.why">{t("install.why")}</summary><p  data-i18n="install.whyBody">{t("install.whyBody")}</p></details></li>
        <li><h4  data-i18n="install.three">{t("install.three")}</h4><h5 data-i18n="install.urlTitle">{t("install.urlTitle")}</h5><p  data-i18n="install.urlHelp">{t("install.urlHelp")}</p><div class="code"><code id="installUrl" tabindex="0">https://decktation.com/Decktation.zip</code><button type="button" class="btn primary" id="copy" data-i18n="install.copy">{t("install.copy")}</button></div><span id="copy-status" class="sr-only" role="status"></span><div class="install-zip-option"><h5 data-i18n="install.zipTitle">{t("install.zipTitle")}</h5><p data-i18n="install.zipHelp">{t("install.zipHelp")}</p><a class="btn" href="https://decktation.com/Decktation.zip" data-i18n="install.downloadZip">{t("install.downloadZip")}</a></div></li>
        <li><h4  data-i18n="install.four">{t("install.four")}</h4><p  data-i18n="install.setup">{t("install.setup")}</p></li></ol><p  data-i18n="install.update">{t("install.update")}</p></div>
      <div id="install-first" class="install-path" hidden><h3 tabindex="-1" data-i18n="install.firstTitle">{t("install.firstTitle")}</h3><p  data-i18n="install.once">{t("install.once")}</p><p class="install-emphasis" data-i18n="install.noTerminal">{t("install.noTerminal")}</p><ol class="install-wizard">
        <li><h4 data-i18n="install.desktop">{t("install.desktop")}</h4><p data-i18n="install.desktopHelp">{t("install.desktopHelp")}</p></li>
        <li><h4  data-i18n="install.downloadStep">{t("install.downloadStep")}</h4><p class="install-emphasis" data-i18n="install.deviceWarning">{t("install.deviceWarning")}</p><div id="install-transfer"><p  data-i18n="install.addressHelp">{t("install.addressHelp")}</p><p><a href="https://decky.xyz/download">decky.xyz/download</a></p><button type="button" class="btn" id="confirm-steamos" data-i18n="install.onDevice">{t("install.onDevice")}</button></div><div id="install-device-download" hidden><a class="btn primary" href="https://decky.xyz/download" data-i18n="install.decky">{t("install.decky")}</a><button type="button" class="text-link" id="other-device" data-i18n="install.otherDevice">{t("install.otherDevice")}</button></div></li>
        <li><h4  data-i18n="install.run">{t("install.run")}</h4><p data-i18n="install.adminHelp">{t("install.adminHelp")}</p><details><summary  data-i18n="install.firefox">{t("install.firefox")}</summary><p  data-i18n="install.firefoxHelp">{t("install.firefoxHelp")}</p></details></li>
        <li><h4  data-i18n="install.return">{t("install.return")}</h4></li></ol><a class="text-link" href="https://github.com/SteamDeckHomebrew/decky-loader#-installation" data-i18n="install.docs">{t("install.docs")}</a><div class="cta-row"><button type="button" class="btn" id="decky-finished" data-i18n="install.finished">{t("install.finished")}</button></div></div>

      <details class="custom-store"><summary data-i18n="install.storeTitle">{t("install.storeTitle")}</summary><p data-i18n="install.storeHelp">{t("install.storeHelp")}</p><p><a href="https://decktation.com/plugins.json">https://decktation.com/plugins.json</a></p></details>
    </div></div>
  </section>

  <section class="alt">
    <div class="wrap privacy">
      <div>
        <div class="section-label" data-i18n="privacy.label">{t("privacy.label")}</div>
        <h2 data-i18n="privacy.title">{t("privacy.title")}</h2>
        <p class="lead" data-i18n="privacy.body">{t("privacy.body")}</p>
      </div>
      <div class="checks"><a class="text-link" href="https://github.com/silverfoxy/decktation/blob/master/doc/PRIVACY_AND_PERMISSIONS.md" data-i18n="privacy.guide">{t("privacy.guide")}</a>
        <div class="check" data-i18n="privacy.one">{t("privacy.one")}</div>
        <div class="check" data-i18n="privacy.two">{t("privacy.two")}</div>
        <div class="check" data-i18n="privacy.three">{t("privacy.three")}</div>
      </div>
    </div>
  </section>

  <section id="games"><div class="wrap"><h2 data-i18n="games.title">{t("games.title")}</h2><div class="steps"><article><div class="game-logo"><img src="/assets/world-of-warcraft-logo.svg" width="160" height="80" alt="" loading="lazy"/></div><h3>World of Warcraft</h3><p data-i18n="games.wow">{t("games.wow")}</p></article><article><div class="game-logo"><img src="/assets/guild-wars-2-logo.svg" width="160" height="80" alt="" loading="lazy"/></div><h3>Guild Wars 2</h3><p data-i18n="games.gw2">{t("games.gw2")}</p></article><article><div class="game-logo"><i class="fa-brands fa-steam" aria-hidden="true"></i></div><h3>Generic</h3><p data-i18n="games.generic">{t("games.generic")}</p></article></div><p data-i18n="games.note">{t("games.note")}</p></div></section>
  <section id="faq">
    <div class="wrap">
      <div class="section-label" data-i18n="faq.label">{t("faq.label")}</div>
      <h2 data-i18n="faq.title">{t("faq.title")}</h2>
      <div class="faq">
        <details><summary data-i18n="faq.internet.q">{t("faq.internet.q")}</summary><p data-i18n="faq.internet.a">{t("faq.internet.a")}</p></details>
        <details><summary data-i18n="faq.upload.q">{t("faq.upload.q")}</summary><p data-i18n="faq.upload.a">{t("faq.upload.a")}</p></details>
        <details><summary data-i18n="faq.games.q">{t("faq.games.q")}</summary><p data-i18n="faq.games.a">{t("faq.games.a")}</p></details>
        <details><summary data-i18n="faq.speed.q">{t("faq.speed.q")}</summary><p data-i18n="faq.speed.a">{t("faq.speed.a")}</p></details>
        <details><summary data-i18n="faq.open.q">{t("faq.open.q")}</summary><p data-i18n="faq.open.a">{t("faq.open.a")}</p></details>
<details><summary data-i18n="faq.devices.q">{t("faq.devices.q")}</summary><p data-i18n="faq.devices.a">{t("faq.devices.a")}</p></details>
<details><summary data-i18n="faq.offline.q">{t("faq.offline.q")}</summary><p data-i18n="faq.offline.a">{t("faq.offline.a")}</p></details>
<details><summary data-i18n="faq.permissions.q">{t("faq.permissions.q")}</summary><p data-i18n="faq.permissions.a">{t("faq.permissions.a")}</p></details>

      </div>
    </div>
  </section>

  <section id="test-builds" class="alt"><div class="wrap"><h2 data-i18n="testing.title">{t("testing.title")}</h2><p class="lead" data-i18n="testing.body">{t("testing.body")}</p><a class="btn" href="/downloads/" data-i18n="docs.downloads">{t("docs.downloads")}</a></div></section>
  <section class="final">
    <div class="wrap">
      <h2 data-i18n="final.title">{t("final.title")}</h2>
      <p class="lead" data-i18n="final.body">{t("final.body")}</p>
      <div class="cta-row">
        <a class="btn primary" href="#install" data-i18n="cta.install">{t("cta.install")}</a>
        <a class="btn" href="https://github.com/silverfoxy/decktation" data-i18n="cta.github">{t("cta.github")}</a>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div><div class="brand"><span class="brand-art"><img class="brand-logo" src="/assets/decktation-logo.png" width="979" height="418" alt="Decktation"/><span class="brand-wave-cover" aria-hidden="true"></span><img class="brand-wave" src="/assets/decktation-logo.png" width="979" height="418" alt="" aria-hidden="true"/></span></div><p data-i18n="footer.body">{t("footer.body")}</p></div>
      <div><h4 data-i18n="footer.project">{t("footer.project")}</h4><a href="https://github.com/silverfoxy/decktation" data-i18n="footer.github">{t("footer.github")}</a><a href="https://github.com/silverfoxy/decktation/releases" data-i18n="footer.releases">{t("footer.releases")}</a></div>
      <div><h4 data-i18n="footer.docs">{t("footer.docs")}</h4><a href="https://github.com/silverfoxy/decktation#install-decktation" data-i18n="footer.installation">{t("footer.installation")}</a><a href="https://github.com/silverfoxy/decktation/blob/master/doc/ADVANCED_CONFIGURATION.md" data-i18n="docs.advanced">{t("docs.advanced")}</a><a href="https://github.com/silverfoxy/decktation/blob/master/doc/TROUBLESHOOTING.md" data-i18n="docs.trouble">{t("docs.trouble")}</a><a href="https://github.com/silverfoxy/decktation/blob/master/doc/PRIVACY_AND_PERMISSIONS.md" data-i18n="docs.privacy">{t("docs.privacy")}</a><a href="/downloads/" data-i18n="docs.downloads">{t("docs.downloads")}</a></div>
      <div><h4 data-i18n="footer.community">{t("footer.community")}</h4><a href="https://github.com/silverfoxy/decktation/issues" data-i18n="footer.issues">{t("footer.issues")}</a></div>
    </div>
    <div class="legal" data-i18n="footer.legal">{t("footer.legal")}</div>
    <div class="theme-picker"><button type="button" class="btn theme-toggle" id="theme-toggle"><span class="theme-auto-icon" aria-hidden="true"><i class="fa-solid fa-sun"></i><i class="fa-solid fa-moon"></i></span><i class="fa-solid fa-sun theme-light-icon" aria-hidden="true"></i><i class="fa-solid fa-moon theme-dark-icon" aria-hidden="true"></i><span class="sr-only" id="theme-description"></span></button><span hidden id="theme-label" data-i18n="theme.label">{t("theme.label")}</span><span hidden id="theme-auto" data-i18n="theme.auto">{t("theme.auto")}</span><span hidden id="theme-light" data-i18n="theme.light">{t("theme.light")}</span><span hidden id="theme-dark" data-i18n="theme.dark">{t("theme.dark")}</span></div>
  </div>
</footer>
